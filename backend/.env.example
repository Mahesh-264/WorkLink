# WorkLink Backend Environment Variables Template
# Copy this file to .env before starting when overriding default credentials.
# Never commit real credentials to version control.

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worklink
DB_USERNAME=postgres
DB_PASSWORD=root

# JWT Security Configuration
# Generate a unique Base64-encoded secret of at least 256 bits for every environment.
# This known value is for local development only; replace it before deployment.
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Access-token lifetime in milliseconds (one hour).
JWT_EXPIRATION_MS=3600000
